# === Banco de Dados (Supabase) ===
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === API LLM (Anthropic Claude) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2048

# === API Portal da Transparência (CGU) ===
CGU_API_KEY=sua-chave-api-aqui
CGU_API_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
CGU_RATE_LIMIT_RPM=400

# === Embeddings ===
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=256

# === HNSW Index ===
HNSW_M=16
HNSW_EF_CONSTRUCTION=200

# === Busca ===
SIMILARITY_THRESHOLD=0.45
MAX_RESULTS=20

# === Aplicação ===
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# === Sync para Produção (sync_to_production.py) ===
PG_HOST=aws-0-sa-east-1.pooler.supabase.com
PG_PORT=5432
PG_DBNAME=postgres
PG_USER=postgres.your-project-ref
PG_PASSWORD=sua-senha-aqui
PG_SSLMODE=require
